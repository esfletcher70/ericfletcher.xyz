# Cloudflare Workers Static Assets header rules.
# https://developers.cloudflare.com/workers/static-assets/headers/
# Served by the ASSETS binding, which bypasses the Worker — so next.config.mjs
# headers() does not reach these paths.

# Content-hashed build output — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the transitional workers.dev deployment out of search results.
https://:subdomain.workers.dev/*
  X-Robots-Tag: noindex
